<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Verse — A World Within Its Own</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Libre+Franklin:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');

:root{
  --bg-paper:#F7F0E6;
  --bg-cream:#FBF6EE;
  --ink:#211D26;
  --ink-soft:#4A4550;
  --verse-red:#A8352A;
  --plum:#4B2B49;
  --plum-soft:#6B4468;
  --gold:#E8AC3E;
  --gold-soft:#F3CE8B;
  --sage:#7C9473;
  --line:rgba(33,29,38,0.12);
}

*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:'Libre Franklin', sans-serif;
  background:var(--bg-paper);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  padding-bottom:76px; /* room for fixed player */
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001s !important; transition-duration:0.001s !important;}
}

a{color:inherit; text-decoration:none;}
.wrap{max-width:1180px; margin:0 auto; padding:0 32px;}

/* ---------- NAV ---------- */
.nav{
  position:sticky; top:0; z-index:40;
  background:rgba(247,240,230,0.9);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.nav .wrap{display:flex; align-items:center; justify-content:space-between; height:76px;}
.wordmark{font-family:'Fraunces', serif; font-weight:600; font-size:1.5rem; letter-spacing:0.02em; color:var(--verse-red);}
.nav-links{display:flex; align-items:center; gap:36px; font-size:0.92rem; letter-spacing:0.03em;}
.nav-links a{opacity:0.75; transition:opacity 0.2s;}
.nav-links a:hover{opacity:1;}
.nav-cta{
  display:flex; align-items:center; gap:8px;
  background:var(--ink); color:var(--bg-cream);
  padding:10px 18px; border-radius:100px;
  font-family:'Space Mono', monospace; font-size:0.78rem; letter-spacing:0.05em;
}
.live-dot{width:7px; height:7px; border-radius:50%; background:var(--gold); animation:pulse-dot 1.6s ease-in-out infinite;}
@keyframes pulse-dot{0%,100%{opacity:1; box-shadow:0 0 0 0 rgba(232,172,62,0.6);} 50%{opacity:0.6; box-shadow:0 0 0 6px rgba(232,172,62,0);}}

/* ---------- HERO / SIGNAL ---------- */
.hero{
  position:relative;
  background:linear-gradient(180deg, #EFD9D0 0%, #E7E2CE 45%, #DCE7DD 100%);
  overflow:hidden;
  padding:100px 0 140px;
}
.hero-content{position:relative; z-index:3; text-align:center; padding-top:180px;}

/* Signal now lives ON the letter — the dot of "i" in "within" doubles as the broadcast source.
   All three layers below share one animation length (--pulse-dur) and start at the same
   moment, so the dot, its glow, and the rays read as a single synced pulse. */
/* Signal sits between "The Verse FM" and "Broadcasting Now" — medium-large, standalone,
   and all three layers (dot, ring, rays) share one animation clock so they blink in sync. */
.eyebrow{
  display:flex; align-items:center; justify-content:center; gap:28px;
  font-family:'Space Mono', monospace; font-size:0.78rem; letter-spacing:0.18em;
  color:var(--plum); text-transform:uppercase; margin-bottom:22px;
}
.signal-mid{
  position:relative; width:140px; height:140px; flex-shrink:0;
  --pulse-dur:2.6s;
  animation:floaty 3.4s ease-in-out infinite; /* the whole unit drifts gently while its parts pulse in sync */
}
.mid-dot{
  position:absolute; top:50%; left:50%;
  width:9px; height:9px; border-radius:50%;
  background:var(--gold); transform:translate(-50%,-50%);
  box-shadow:0 0 14px 3px rgba(232,172,62,0.75);
  animation:dotpulse var(--pulse-dur) ease-in-out infinite;
}
.mid-ring{
  position:absolute; top:50%; left:50%;
  border:1.5px solid rgba(232,172,62,0.55); border-radius:50%;
  transform:translate(-50%,-50%);
  animation:midringpulse var(--pulse-dur) ease-out infinite;
}
.mid-ray{
  position:absolute; top:50%; left:50%;
  width:2.5px; height:54px;
  background:linear-gradient(180deg, var(--gold) 0%, rgba(232,172,62,0) 100%);
  transform-origin:top center;
  filter:drop-shadow(0 0 5px rgba(232,172,62,0.6));
  animation:midraypulse var(--pulse-dur) ease-in-out infinite;
}
@keyframes floaty{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-10px);}
}
@keyframes dotpulse{
  0%,100%{transform:translate(-50%,-50%) scale(1); opacity:1;}
  50%{transform:translate(-50%,-50%) scale(0.7); opacity:0.55;}
}
@keyframes midringpulse{
  0%{width:16px; height:16px; opacity:0.75;}
  100%{width:130px; height:130px; opacity:0;}
}
@keyframes midraypulse{
  0%,100%{opacity:0.9; height:54px;}
  50%{opacity:0.3; height:38px;}
}
.hero-title{
  font-family:'Fraunces', serif; font-weight:500; font-style:italic;
  font-size:clamp(2.4rem, 6vw, 4.6rem); line-height:1.05; letter-spacing:-0.01em;
  color:var(--ink); max-width:840px; margin:0 auto 22px;
}
.hero-sub{
  font-size:1.05rem; color:var(--ink-soft); max-width:520px; margin:0 auto 40px; line-height:1.6;
}
.hero-ctas{display:flex; gap:16px; justify-content:center; flex-wrap:wrap;}
.btn{
  padding:14px 30px; border-radius:100px; font-size:0.92rem; letter-spacing:0.02em; font-weight:500;
  transition:transform 0.2s ease, box-shadow 0.2s ease;
  display:inline-block;
}
.btn:hover{transform:translateY(-2px);}
.btn-primary{background:var(--verse-red); color:var(--bg-cream); box-shadow:0 8px 20px rgba(168,53,42,0.25);}
.btn-ghost{border:1px solid var(--ink); color:var(--ink);}

.ticker-wrap{
  position:relative; z-index:3; margin-top:70px;
  border-top:1px solid var(--line); border-bottom:1px solid var(--line);
  background:var(--ink); overflow:hidden; padding:12px 0;
}
.ticker{
  display:flex; white-space:nowrap;
  animation:scroll 22s linear infinite;
  font-family:'Space Mono', monospace; font-size:0.82rem; letter-spacing:0.08em;
  color:var(--gold-soft);
}
.ticker span{padding:0 28px;}
@keyframes scroll{0%{transform:translateX(0);} 100%{transform:translateX(-50%);}}

/* ---------- ABOUT ---------- */
.about{padding:120px 0; background:var(--bg-paper);}
.about-intro{display:grid; grid-template-columns:1fr 1fr; gap:60px; margin-bottom:90px; text-align:left;}
.about-block .label{font-family:'Space Mono', monospace; font-size:0.7rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--sage); margin-bottom:10px;}
.about-block h3{font-family:'Fraunces', serif; font-style:italic; font-weight:500; font-size:1.6rem; margin-bottom:16px; color:var(--verse-red);}
.about-block h3.plum{color:var(--plum);}
.about-block p{font-size:0.95rem; line-height:1.75; color:var(--ink-soft); margin-bottom:16px;}

.grid-head{text-align:center; margin-bottom:44px;}
.grid-head .section-title{font-size:1.5rem;}
.pillars{display:grid; grid-template-columns:repeat(5,1fr); gap:20px; margin-bottom:90px;}
.pillar{text-align:center;}
.pillar-icon{
  width:48px; height:48px; border-radius:50%; margin:0 auto 16px;
  border:1.5px solid var(--ink); display:flex; align-items:center; justify-content:center;
  font-family:'Fraunces', serif; font-style:italic; font-size:1rem; color:var(--verse-red);
}
.pillar-name{font-weight:600; font-size:0.92rem; margin-bottom:6px; font-family:'Fraunces', serif;}
.pillar-desc{font-size:0.8rem; color:var(--ink-soft); line-height:1.5;}

.values{display:grid; grid-template-columns:repeat(5,1fr); gap:20px;}
.value-icon{border-color:var(--plum);}
.value-icon{color:var(--plum);}

.tag-rows{margin-top:70px; text-align:center;}
.tag-rows .label{justify-content:center; display:flex; margin-bottom:16px;}
.tag-row{display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:30px;}
.tag{
  font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.04em;
  padding:7px 16px; border:1px solid var(--line); border-radius:100px; color:var(--ink-soft);
}

/* ---------- SCHEDULE ---------- */
.schedule{padding:120px 0; background:var(--bg-cream);}
.schedule-note{
  text-align:center; font-size:0.85rem; color:var(--ink-soft); max-width:480px;
  margin:-20px auto 50px; line-height:1.6;
}
.lineup{max-width:760px; margin:0 auto;}
.slot{
  display:grid; grid-template-columns:150px 1fr; gap:24px; align-items:baseline;
  padding:26px 0; border-bottom:1px solid var(--line);
}
.slot:first-child{border-top:1px solid var(--line);}
.slot-time{font-family:'Space Mono', monospace; font-size:0.82rem; color:var(--sage); letter-spacing:0.04em;}
.slot-show{font-family:'Fraunces', serif; font-style:italic; font-weight:500; font-size:1.2rem; margin-bottom:6px;}
.slot-desc{font-size:0.88rem; color:var(--ink-soft); line-height:1.5;}

/* ---------- PSA / COMMUNITY ---------- */
.psa{padding:120px 0; background:var(--bg-paper);}
.psa-note{
  text-align:center; font-size:0.85rem; color:var(--ink-soft); max-width:480px;
  margin:-20px auto 50px; line-height:1.6;
}
.psa-cards{max-width:800px; margin:0 auto; display:flex; flex-direction:column; gap:2px;}
.psa-card{
  background:var(--bg-cream); border-left:3px solid var(--verse-red);
  padding:28px 32px; border-radius:2px;
}
.psa-card.plum{border-left-color:var(--plum);}
.psa-card.sage{border-left-color:var(--sage);}
.psa-tag{
  font-family:'Space Mono', monospace; font-size:0.7rem; letter-spacing:0.1em;
  text-transform:uppercase; color:var(--verse-red); margin-bottom:10px; display:block;
}
.psa-card.plum .psa-tag{color:var(--plum);}
.psa-card.sage .psa-tag{color:var(--sage);}
.psa-headline{font-family:'Fraunces', serif; font-weight:500; font-size:1.15rem; margin-bottom:8px;}
.psa-body{font-size:0.9rem; color:var(--ink-soft); line-height:1.6; margin-bottom:10px;}
.psa-date{font-family:'Space Mono', monospace; font-size:0.72rem; color:var(--ink-soft); opacity:0.7;}

/* ---------- DUALITY ---------- */
.duality{padding:120px 0; background:var(--bg-cream);}
.duality-head{text-align:center; max-width:640px; margin:0 auto 70px;}
.section-label{
  font-family:'Space Mono', monospace; font-size:0.75rem; letter-spacing:0.16em;
  text-transform:uppercase; color:var(--sage); margin-bottom:16px;
}
.section-title{font-family:'Fraunces', serif; font-weight:500; font-size:clamp(1.8rem,3.4vw,2.6rem); line-height:1.2;}

.panels{display:grid; grid-template-columns:1fr 1fr; gap:2px; background:var(--line); border-radius:20px; overflow:hidden;}
.panel{padding:56px 48px; position:relative;}
.panel-verse{background:linear-gradient(160deg, #F5E4DD 0%, #EFD9D0 100%);}
.panel-ent{background:linear-gradient(160deg, #4B2B49 0%, #33203A 100%); color:#F0E6EE;}
.panel-tag{font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; opacity:0.65; margin-bottom:14px;}
.panel-title{font-family:'Fraunces', serif; font-style:italic; font-weight:500; font-size:2rem; margin-bottom:18px;}
.panel-verse .panel-title{color:var(--verse-red);}
.panel-ent .panel-title{color:var(--gold-soft);}
.panel-body{font-size:0.98rem; line-height:1.7; margin-bottom:28px; max-width:400px;}
.panel-ent .panel-body{color:rgba(240,230,238,0.8);}
.panel-verse .panel-body{color:var(--ink-soft);}
.panel-link{font-size:0.88rem; font-weight:600; border-bottom:1.5px solid currentColor; padding-bottom:2px;}

/* ---------- SIGNAL CHAIN ---------- */
.chain{padding:110px 0; background:var(--bg-paper);}
.chain-row{display:flex; align-items:center; justify-content:center; gap:0; flex-wrap:wrap; margin-top:60px;}
.chain-step{text-align:center; width:220px; padding:0 20px;}
.chain-icon{
  width:64px; height:64px; border-radius:50%; margin:0 auto 20px;
  border:1.5px solid var(--ink); display:flex; align-items:center; justify-content:center;
  font-family:'Fraunces', serif; font-style:italic; font-size:1.3rem; color:var(--verse-red);
}
.chain-name{font-weight:600; font-size:1.02rem; margin-bottom:8px; font-family:'Fraunces', serif;}
.chain-desc{font-size:0.86rem; color:var(--ink-soft); line-height:1.5;}
.chain-arrow{
  font-family:'Space Mono', monospace; color:var(--gold); font-size:1.4rem;
  align-self:center; margin:0 6px; opacity:0.7;
}

/* ---------- SCRIPTURE ---------- */
.verse-quote{padding:130px 0; text-align:center; background:var(--bg-cream);}
.verse-quote blockquote{
  font-family:'Fraunces', serif; font-style:italic; font-weight:500;
  font-size:clamp(1.3rem,2.6vw,1.9rem); line-height:1.55; max-width:680px; margin:0 auto 26px; color:var(--ink);
}
.verse-quote cite{font-family:'Space Mono', monospace; font-size:0.78rem; letter-spacing:0.1em; color:var(--sage); font-style:normal;}

/* ---------- FOOTER ---------- */
footer{background:var(--ink); color:rgba(247,240,230,0.7); padding:70px 0 40px;}
.foot-top{display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:40px; padding-bottom:50px; border-bottom:1px solid rgba(247,240,230,0.12);}
.foot-wordmark{font-family:'Fraunces', serif; font-style:italic; font-size:1.6rem; color:var(--gold-soft); margin-bottom:14px;}
.foot-motto{max-width:340px; font-size:0.92rem; line-height:1.6;}
.foot-cols{display:flex; gap:70px; flex-wrap:wrap;}
.foot-col-title{font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--gold-soft); margin-bottom:16px;}
.foot-col a{display:block; font-size:0.9rem; margin-bottom:10px; opacity:0.8;}
.foot-bottom{padding-top:28px; font-size:0.78rem; opacity:0.55; display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}

/* ---------- PLAYER BAR ---------- */
.player{
  position:fixed; bottom:0; left:0; right:0; z-index:50;
  background:var(--ink); border-top:1px solid rgba(247,240,230,0.15);
  height:76px; display:flex; align-items:center;
}
.player .wrap{display:flex; align-items:center; justify-content:space-between; width:100%;}
.player-left{display:flex; align-items:center; gap:16px;}
.play-btn{
  width:42px; height:42px; border-radius:50%; background:var(--gold); color:var(--ink);
  display:flex; align-items:center; justify-content:center; cursor:pointer; border:none; flex-shrink:0;
  transition:transform 0.15s ease;
}
.play-btn:hover{transform:scale(1.06);}
.play-btn svg{width:16px; height:16px;}
.station-meta{color:var(--bg-cream);}
.station-name{font-family:'Fraunces', serif; font-style:italic; font-size:1rem; line-height:1.2;}
.station-track{font-family:'Space Mono', monospace; font-size:0.72rem; color:var(--gold-soft); letter-spacing:0.03em; margin-top:2px;}
.player-right{display:flex; align-items:center; gap:20px;}
.on-air{
  display:flex; align-items:center; gap:8px; font-family:'Space Mono', monospace;
  font-size:0.72rem; letter-spacing:0.1em; color:var(--bg-cream); opacity:0.85;
}
.player-cta{
  font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.05em;
  color:var(--ink); background:var(--bg-cream); padding:9px 16px; border-radius:100px;
}

@media (max-width:820px){
  .panels{grid-template-columns:1fr;}
  .nav-links{display:none;}
  .foot-top{flex-direction:column;}
  .chain-arrow{display:none;}
  .station-track{display:none;}
  .about-intro{grid-template-columns:1fr;}
  .pillars,.values{grid-template-columns:repeat(2,1fr); row-gap:36px;}
  .slot{grid-template-columns:1fr;}
}
</style>
</head>
