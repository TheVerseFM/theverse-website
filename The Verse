<audio id="stream" preload="none" src=""></audio>

<script>
// Standalone signal between "The Verse FM" and "Broadcasting Now" — dot, ring, and
// every ray share the same animation + start time (no per-ray delay), so it all
// blinks and radiates as one synced beat rather than drifting independently.
const signalMid = document.getElementById('signalMid');
const rayCount = 10;
for(let i=0;i<rayCount;i++){
  const ray = document.createElement('div');
  ray.className = 'mid-ray';
  const angle = (360/rayCount)*i;
  ray.style.transform = `translate(-50%,0%) rotate(${angle}deg)`;
  signalMid.appendChild(ray);
}
const ring = document.createElement('div');
ring.className = 'mid-ring';
signalMid.appendChild(ring);

const dot = document.createElement('div');
dot.className = 'mid-dot';
signalMid.appendChild(dot);

// Play/pause toggle (wire "stream" audio src to your radio.co URL to activate)
const playBtn = document.getElementById('playBtn');
const playIcon = document.getElementById('playIcon');
const audio = document.getElementById('stream');
let playing = false;
playBtn.addEventListener('click', () => {
  playing = !playing;
  playIcon.innerHTML = playing
    ? '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>'
    : '<path d="M8 5v14l11-7z"/>';
  if(audio.src){ playing ? audio.play() : audio.pause(); }
});
</script>

